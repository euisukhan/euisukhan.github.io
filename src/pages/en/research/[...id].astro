---
import { render } from 'astro:content';
import Article from '../../../components/Article.astro';
import { entries, counterpart, hrefFor, slugOf } from '../../../lib/content';
export async function getStaticPaths() {
  const list = await entries('research', 'en');
  return Promise.all(list.map(async (entry) => ({ params: { id: slugOf(entry.id) }, props: { entry, alt: await counterpart('research', entry) } })));
}
const { entry, alt } = Astro.props;
const { Content } = await render(entry);
---
<Article title={entry.data.title} date={entry.data.date} summary={entry.data.summary} lang="en" kicker={`Research · ${entry.data.kind}`} alternate={alt ? hrefFor('research', alt) : undefined}>
  {entry.data.link && <p class="meta"><a href={entry.data.link}>External record (OSF / preprint)</a></p>}
  <Content />
</Article>
