---
import { render } from 'astro:content';
import Article from '../../../components/Article.astro';
import { entries, counterpart, hrefFor, slugOf } from '../../../lib/content';
export async function getStaticPaths() {
  const list = await entries('tools', 'en');
  return Promise.all(list.map(async (entry) => ({ params: { id: slugOf(entry.id) }, props: { entry, alt: await counterpart('tools', entry) } })));
}
const { entry, alt } = Astro.props;
const { Content } = await render(entry);
const statusLabel = ({ personal: 'personal use', alpha: 'alpha', public: 'public' } as const)[entry.data.status as 'personal' | 'alpha' | 'public'];
---
<Article title={entry.data.title} date={entry.data.date} summary={entry.data.summary} lang="en" kicker={`Tool · ${statusLabel}`} alternate={alt ? hrefFor('tools', alt) : undefined}>
  {entry.data.repo && <p class="meta"><a href={entry.data.repo}>Repository</a></p>}
  <Content />
</Article>
