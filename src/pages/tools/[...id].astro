---
import { render } from 'astro:content';
import Article from '../../components/Article.astro';
import { entries, counterpart, hrefFor } from '../../lib/content';
export async function getStaticPaths() {
  const list = await entries('tools', 'ko');
  return Promise.all(list.map(async (entry) => ({ params: { id: entry.id }, props: { entry, alt: await counterpart('tools', entry) } })));
}
const { entry, alt } = Astro.props;
const { Content } = await render(entry);
const statusLabel = ({ personal: '개인 사용 중', alpha: '알파', public: '공개' } as const)[entry.data.status as 'personal' | 'alpha' | 'public'];
---
<Article title={entry.data.title} date={entry.data.date} summary={entry.data.summary} lang="ko" kicker={`Tool · ${statusLabel}`} alternate={alt ? hrefFor('tools', alt) : undefined}>
  {entry.data.repo && <p class="meta"><a href={entry.data.repo}>저장소</a></p>}
  <Content />
</Article>
