---
import { render } from 'astro:content';
import Article from '../../components/Article.astro';
import { entries, counterpart, hrefFor } from '../../lib/content';
export async function getStaticPaths() {
  const list = await entries('research', 'ko');
  return Promise.all(list.map(async (entry) => ({ params: { id: entry.id }, props: { entry, alt: await counterpart('research', entry) } })));
}
const { entry, alt } = Astro.props;
const { Content } = await render(entry);
---
<Article title={entry.data.title} date={entry.data.date} summary={entry.data.summary} lang="ko" kicker={`Research · ${entry.data.kind}`} alternate={alt ? hrefFor('research', alt) : undefined}>
  {entry.data.link && <p class="meta"><a href={entry.data.link}>외부 기록 (OSF / 프리프린트)</a></p>}
  <Content />
</Article>
