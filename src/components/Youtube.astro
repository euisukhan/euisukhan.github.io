---
interface Props { id: string; title?: string }
const { id, title = 'YouTube video' } = Astro.props;
---
<iframe class="video" src={`https://www.youtube-nocookie.com/embed/${id}`} title={title} loading="lazy"
  allow="accelerometer; encrypted-media; picture-in-picture" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>
